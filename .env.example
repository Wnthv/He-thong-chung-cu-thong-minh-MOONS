APP_NAME="Chung cư Moons"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- CSDL MySQL/MariaDB (WAMP/XAMPP mặc định: root, không mật khẩu) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moons
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# ---- Cấu hình nghiệp vụ Moons (config/moons.php) ----
# Cố định ngày hệ thống để khớp bộ dữ liệu trong báo cáo (để trống = ngày thực tế)
MOONS_FIXED_TODAY=2026-11-04
# VNPay: để trống TMN code => dùng cổng VNPay mô phỏng
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=MOONSDEMOSECRETKEY2026HMACSHA512
# Gemini: để trống => Trợ lý AI chạy chế độ tra cứu nội quy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=20
# Model dự phòng khi model chính quá tải (HTTP 503), cách nhau dấu phẩy
GEMINI_FALLBACK_MODELS=
OTP_DEMO=true
