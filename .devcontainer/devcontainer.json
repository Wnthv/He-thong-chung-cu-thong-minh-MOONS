{
  "name": "Moons – Laravel + MariaDB",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Web Moons", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["bmewburn.vscode-intelephense-client", "onecentlabs.laravel-blade"] }
  }
}
