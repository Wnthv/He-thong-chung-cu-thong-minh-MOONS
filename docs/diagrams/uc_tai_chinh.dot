f[shape=ellipse,style=filled,fillcolor="#F2F6F3",color="#5F7B6F",label="UC-KTT01 Hủy hóa đơn"];
g[shape=ellipse,style=filled,fillcolor="#F2F6F3",color="#5F7B6F",label="UC-KTT02 Cập nhật biểu phí"];
h[shape=ellipse,style=filled,fillcolor="#F2F6F3",color="#5F7B6F",label="UC-ACC03 Gạch nợ thủ công"];
i[shape=ellipse,style=filled,fillcolor="#F2F6F3",color="#5F7B6F",label="UC-ACC04 Đối soát IPN"];
j[shape=ellipse,style=filled,fillcolor="#F2F6F3",color="#5F7B6F",label="UC-ACC05 Báo cáo công nợ"];
