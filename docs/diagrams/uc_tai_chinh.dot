vn[shape=none,label="☺\n«system»\nVNPay",fontsize=11,image=""];
subgraph cluster_sys {label="Phân hệ tài chính & thanh toán";style=rounded;color="#5F7B6F";fontname="DejaVu Sans";
a[shape=ellipse,style=filled,fillcolor="#F2F6F3",color="#5F7B6F",label="UC-RES05 Tra cứu hóa đơn"];
b[shape=ellipse,style=filled,fillcolor="#F2F6F3",color="#5F7B6F",label="UC-RES06 Thanh toán VNPay"];
